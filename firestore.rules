rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user has exclusive read and write access to their own data document and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Any nested collections (e.g., custom mission archives, audit logs)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
